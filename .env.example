# Copia questo file in ".env" per cambiare la configurazione usata da docker compose.
# Se MongoDB gira in un container sulla stessa macchina, usa host.docker.internal, non localhost.
# directConnection=true serve con il replica set a un nodo (vedi docs/mongodb-replica-set.md).
MONGODB_URI=mongodb://host.docker.internal:27017/toolpm?directConnection=true

# --- Autenticazione (fase 1, blocco B2) ---
# Segreto per firmare i token di accesso: una stringa casuale lunga, diversa per ogni installazione
# (es. il risultato di: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Se manca, il backend ne usa uno casuale e gli accessi scadono a ogni riavvio.
JWT_SECRET=
# Durata dell'accesso (es. 8h, 30m, 7d).
JWT_DURATA=8h
# Primo amministratore: creato all'avvio solo se non esiste ancora un utente admin.
# Al primo accesso dovrà cambiare la password (almeno 10 caratteri).
ADMIN_EMAIL=
ADMIN_PASSWORD_INIZIALE=
# true se ToolPM è servito in HTTPS: il cookie viene mandato solo su connessioni sicure.
COOKIE_SECURE=false
