# Copia questo file in ".env" per cambiare la configurazione usata da docker compose.
# Se MongoDB gira in un container sulla stessa macchina, usa host.docker.internal, non localhost.
# directConnection=true serve con il replica set a un nodo (vedi docs/mongodb-replica-set.md).
MONGODB_URI=mongodb://host.docker.internal:27017/toolpm?directConnection=true

# --- Autenticazione (fase 1, blocco B2: non ancora usate dal backend) ---
# Segreto per firmare i token di accesso: una stringa casuale lunga, diversa per ogni installazione.
# JWT_SECRET=
# Durata del token di accesso (es. 8h).
# JWT_DURATA=8h
# Primo amministratore, creato dalla migrazione iniziale se non esiste.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_INIZIALE=
